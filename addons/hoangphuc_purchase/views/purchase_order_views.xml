<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_hoangphuc" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.hoangphuc</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- 1. Thêm các nút phê duyệt chỉ hiển thị ở role tương ứng -->
            <xpath expr="//header" position="inside">
                <field name="user_is_gm" invisible="1"/>
                <field name="user_is_chairman" invisible="1"/>
                <field name="user_can_gm_approve" invisible="1"/>
                <field name="user_can_chairman_approve" invisible="1"/>
                <field name="user_can_reject" invisible="1"/>
                <field name="approval_tier" invisible="1"/>

                <!-- Nút TGĐ Phê Duyệt: Chỉ hiển thị khi state == waiting_gm VÀ user là TGĐ VÀ <= 20M -->
                <button name="action_gm_approve" string="Phê Duyệt" type="object" class="btn-success"
                        invisible="not user_can_gm_approve or approval_tier != 'tier_1'"/>

                <!-- Nút TGĐ Duyệt & Trình Chủ Tịch: Chỉ hiển thị khi state == waiting_gm VÀ user là TGĐ VÀ > 20M -->
                <button name="action_gm_approve" string="Duyệt &amp; Trình Chủ Tịch" type="object" class="btn-primary"
                        invisible="not user_can_gm_approve or approval_tier != 'tier_2'"/>

                <!-- Nút Chủ Tịch HĐQT Phê Duyệt: Chỉ hiển thị khi state == waiting_chairman VÀ user là Chủ Tịch HĐQT -->
                <button name="action_chairman_approve" string="Phê Duyệt" type="object" class="btn-success"
                        invisible="not user_can_chairman_approve"/>

                <!-- Nút Từ chối: Chỉ cấp thẩm quyền tương ứng mới thấy khi ở state chờ duyệt -->
                <button name="action_reject_to_draft" string="Từ chối" type="object" class="btn-warning"
                        invisible="not user_can_reject"/>
            </xpath>

            <!-- 3. Cho phép Hủy đơn ở cả các trạng thái chờ duyệt -->
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">state not in ('draft', 'to approve', 'sent', 'purchase', 'waiting_gm', 'waiting_chairman') or locked</attribute>
            </xpath>

            <!-- Thêm trường thiết bị mỏ chịu chi phí BR-10 sau partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="equipment_id" placeholder="Chọn thiết bị / xe máy mỏ chịu chi phí"/>
                <field name="supplier_payment_term_type"/>
            </xpath>

            <!-- Thêm 2 Tab: So Sánh 3 Báo Giá và Nghiệm Thu Hiện Trường -->
            <xpath expr="//notebook" position="inside">
                <page string="Quy Tắc 3 Báo Giá &amp; Chỉ Định Thầu (BR-02)" name="quotes_comparison">
                    <group>
                        <group string="Mua 1 Nguồn Duy Nhất (Chỉ Định Thầu)">
                            <field name="is_single_source" widget="boolean_toggle"/>
                            <field name="single_source_reason" invisible="not is_single_source" required="is_single_source" placeholder="Giải trình lý do kỹ thuật độc quyền hoặc sự cố khẩn cấp..."/>
                        </group>
                    </group>
                    <group string="So Sánh 3 Báo Giá Cạnh Tranh (Nếu Có >= 2 Nguồn)" invisible="is_single_source">
                        <group string="Báo Giá 1 (Được Chọn)">
                            <field name="quote_source_1" placeholder="Tên NCC 1"/>
                            <field name="quote_price_1"/>
                        </group>
                        <group string="Báo Giá 2">
                            <field name="quote_source_2" placeholder="Tên NCC 2"/>
                            <field name="quote_price_2"/>
                        </group>
                        <group string="Báo Giá 3">
                            <field name="quote_source_3" placeholder="Tên NCC 3"/>
                            <field name="quote_price_3"/>
                        </group>
                    </group>
                </page>

                <page string="Nghiệm Thu Bàn Giao Hiện Trường (BR-05)" name="field_inspection">
                    <group>
                        <group string="Biên Bản Kiểm Tra Thực Tế">
                            <field name="field_inspected" widget="boolean_toggle"/>
                            <field name="field_inspector_id"/>
                        </group>
                        <group string="Hình Ảnh Hiện Trường Moong Mỏ / Xưởng">
                            <field name="field_inspection_photo" widget="image" class="oe_avatar" options="{'size': [200, 200]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Tree/List View của Purchase Order để hiển thị cột Thiết Bị & Cấp Duyệt -->
    <record id="purchase_order_view_tree_inherit_hoangphuc" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.hoangphuc</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="equipment_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Search View của Purchase Order để thêm bộ lọc trạng thái Chờ TGĐ & Chờ CT HĐQT duyệt -->
    <record id="purchase_order_view_search_inherit_hoangphuc" model="ir.ui.view">
        <field name="name">purchase.order.search.inherit.hoangphuc</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='waiting_rfqs']" position="after">
                <separator/>
                <filter name="filter_need_my_approval" string="Cần Phê Duyệt" domain="[('need_my_approval', '=', True)]"/>
                <filter name="filter_waiting_gm" string="Chờ TGĐ Phê Duyệt" domain="[('state', '=', 'waiting_gm')]"/>
                <filter name="filter_waiting_chairman" string="Chờ Chủ Tịch HĐQT Phê Duyệt" domain="[('state', '=', 'waiting_chairman')]"/>
            </xpath>
        </field>
    </record>

    <!-- Cửa sổ hành động (Action) dành riêng cho các đơn hàng cần cấp thẩm quyền phê duyệt -->
    <record id="action_purchase_order_to_approve" model="ir.actions.act_window">
        <field name="name">Đơn Hàng Chờ Phê Duyệt</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="domain">[('need_my_approval', '=', True)]</field>
        <field name="search_view_id" ref="purchase.view_purchase_order_filter"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Không có đơn hàng nào đang chờ bạn phê duyệt!
            </p>
        </field>
    </record>

    <!-- Menu Chờ Phê Duyệt: Hiển thị ngay dưới Mua Hàng / Đơn Hàng -->
    <menuitem id="menu_purchase_order_to_approve"
              name="Chờ Phê Duyệt"
              parent="purchase.menu_procurement_management"
              action="action_purchase_order_to_approve"
              sequence="3"/>
</odoo>
