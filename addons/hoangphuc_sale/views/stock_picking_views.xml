<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_sale_deposit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.sale.deposit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="hoangphuc_stock.view_picking_form_inherit_hoangphuc"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='scale_info']" position="inside">
                <group string="Kiểm Soát Ký Quỹ &amp; Trừ Tiền Xuất Đá" invisible="partner_quarry_type != 'prepaid'">
                    <group>
                        <field name="partner_quarry_type"/>
                        <field name="partner_deposit_balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                    <group>
                        <field name="is_deposit_deducted" widget="boolean_toggle"/>
                        <field name="deducted_deposit_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not is_deposit_deducted"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
