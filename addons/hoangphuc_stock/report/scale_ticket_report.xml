<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_scale_ticket" model="ir.actions.report">
            <field name="name">Phiếu Cân Xe Điện Tử</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hoangphuc_stock.report_scale_ticket_template</field>
            <field name="report_file">hoangphuc_stock.report_scale_ticket_template</field>
            <field name="print_report_name">'Phieu_Can_' + (object.vehicle_plate or object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_scale_ticket_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <div class="article page" style="font-family: Arial, sans-serif; font-size: 14px; padding: 25px; line-height: 1.5;">
                        <div style="border: 2px solid #333; padding: 20px; border-radius: 8px;">
                            <!-- Tiêu đề -->
                            <div style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 15px; margin-bottom: 20px;">
                                <h3 style="margin: 0; text-transform: uppercase; font-weight: bold; color: #1a3a60;">CÔNG TY CP KHAI THÁC &amp; CHẾ BIẾN ĐÁ HOÀNG PHÚC</h3>
                                <p style="margin: 3px 0; font-size: 12px; color: #555;">Khu vực khai thác mỏ đá Núi Dài - Hà Trung - Thanh Hóa | Hotline: 0988.xxx.xxx</p>
                                <h2 style="margin: 15px 0 5px 0; text-transform: uppercase; font-weight: bold; color: #c0392b;">PHIẾU CÂN XE ĐIỆN TỬ</h2>
                                <p style="margin: 0; font-style: italic; font-size: 13px;">(Bilingual Scale Ticket / Finished Stone Dispatch)</p>
                                <p style="margin: 5px 0 0 0; font-size: 13px;"><b>Mã phiếu kho:</b> <span t-field="o.name"/> | <b>Ngày:</b> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></p>
                            </div>

                            <!-- Thông tin xe & khách hàng -->
                            <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 50%; padding: 6px 0;"><b>Biển số xe (Truck Plate):</b> <span style="font-size: 16px; font-weight: bold; color: #c0392b;" t-field="o.vehicle_plate"/></td>
                                    <td style="width: 50%; padding: 6px 0;"><b>Tài xế (Driver):</b> <span t-field="o.driver_name"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 0;"><b>Khách hàng / Đối tác:</b> <span t-field="o.partner_id.name"/></td>
                                    <td style="padding: 6px 0;"><b>Trạm cân:</b> <span t-field="o.weigh_scale_number"/></td>
                                </tr>
                                <tr t-if="o.crushing_plant">
                                    <td colspan="2" style="padding: 6px 0;"><b>Trạm nghiền / Cấp liệu:</b> <span t-field="o.crushing_plant"/></td>
                                </tr>
                            </table>

                            <!-- Bảng kết quả cân -->
                            <table style="width: 100%; border: 1px solid #333; border-collapse: collapse; margin-bottom: 20px; text-align: center;">
                                <thead>
                                    <tr style="background-color: #f2f2f2;">
                                        <th style="border: 1px solid #333; padding: 10px;">Chỉ tiêu cân (Indicator)</th>
                                        <th style="border: 1px solid #333; padding: 10px;">Khối lượng (Kg)</th>
                                        <th style="border: 1px solid #333; padding: 10px;">Quy đổi Tấn</th>
                                        <th style="border: 1px solid #333; padding: 10px;">Thời gian cân</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #333; padding: 8px; text-align: left;">1. Khối lượng tổng (Gross Weight)</td>
                                        <td style="border: 1px solid #333; padding: 8px;"><b t-esc="'{:,.2f}'.format(o.gross_weight)"/></td>
                                        <td style="border: 1px solid #333; padding: 8px;"><span t-esc="'{:,.2f}'.format(o.gross_weight / 1000.0)"/></td>
                                        <td style="border: 1px solid #333; padding: 8px;"><span t-field="o.weigh_time_first"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #333; padding: 8px; text-align: left;">2. Khối lượng bì (Tare Weight)</td>
                                        <td style="border: 1px solid #333; padding: 8px;"><b t-esc="'{:,.2f}'.format(o.tare_weight)"/></td>
                                        <td style="border: 1px solid #333; padding: 8px;"><span t-esc="'{:,.2f}'.format(o.tare_weight / 1000.0)"/></td>
                                        <td style="border: 1px solid #333; padding: 8px;"><span t-field="o.weigh_time_second"/></td>
                                    </tr>
                                    <tr style="background-color: #e8f4fd;">
                                        <td style="border: 1px solid #333; padding: 10px; text-align: left; font-weight: bold; font-size: 15px; color: #0b5394;">
                                            3. KHỐI LƯỢNG TỊNH (Net Weight)
                                        </td>
                                        <td style="border: 1px solid #333; padding: 10px; font-weight: bold; font-size: 16px; color: #0b5394;">
                                            <span t-esc="'{:,.2f}'.format(o.net_weight)"/>
                                        </td>
                                        <td style="border: 1px solid #333; padding: 10px; font-weight: bold; font-size: 16px; color: #0b5394;">
                                            <span t-esc="'{:,.2f}'.format(o.net_weight / 1000.0)"/> Tấn
                                        </td>
                                        <td style="border: 1px solid #333; padding: 10px;">Chênh lệch</td>
                                    </tr>
                                    <tr style="background-color: #eafaf1;">
                                        <td style="border: 1px solid #333; padding: 10px; text-align: left; font-weight: bold; color: #27ae60;">
                                            4. THỂ TÍCH QUY ĐỔI (m³)
                                            <span style="font-size: 11px; font-weight: normal;">(Tỷ trọng: <span t-field="o.density"/> tấn/m³)</span>
                                        </td>
                                        <td colspan="3" style="border: 1px solid #333; padding: 10px; font-weight: bold; font-size: 18px; color: #27ae60;">
                                            <span t-esc="'{:,.2f}'.format(o.volume_m3)"/> m³
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Chi tiết sản phẩm -->
                            <div t-if="o.move_ids" style="margin-bottom: 25px;">
                                <p style="margin: 0 0 5px 0;"><b>Chủng loại đá / Sản phẩm:</b> 
                                    <span style="font-weight: bold;" t-esc="', '.join(o.move_ids.mapped('product_id.display_name'))"/>
                                </p>
                            </div>

                            <!-- Chữ ký -->
                            <table style="width: 100%; text-align: center; margin-top: 30px;">
                                <tr>
                                    <td style="width: 50%;">
                                        <b>LÁI XE VẬN TẢI</b><br/>
                                        <i>(Ký và ghi rõ họ tên)</i>
                                        <div style="height: 60px;"></div>
                                        <span t-field="o.driver_name"/>
                                    </td>
                                    <td style="width: 50%;">
                                        <b>NHÂN VIÊN TRẠM CÂN</b><br/>
                                        <i>(Ký và ghi rõ họ tên)</i>
                                        <div style="height: 60px;"></div>
                                        <span t-esc="user.name"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
