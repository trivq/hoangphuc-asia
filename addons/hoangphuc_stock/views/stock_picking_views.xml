<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa Form View của Stock Picking để thêm tính năng Trạm Cân & Phân Loại Nghiệp Vụ Mỏ Đá -->
    <record id="view_picking_form_inherit_hoangphuc" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.hoangphuc</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Thêm nút In Phiếu Cân và Áp Số Lượng Cân trên Header (Chỉ hiển thị khi là phiếu trạm cân và có khối lượng tịnh) -->
            <xpath expr="//header" position="inside">
                <button name="action_print_scale_ticket" string="In Phiếu Cân" type="object" class="btn-secondary" icon="fa-print" invisible="not show_scale_tab or not net_weight"/>
                <button name="action_apply_scale_to_moves" string="Áp Khối Lượng Cân" type="object" class="btn-primary" icon="fa-balance-scale" invisible="not show_scale_tab or not net_weight"/>
            </xpath>

            <!-- Hiển thị Trạng Thái của từng dòng Stock Move để người dùng theo dõi rõ ràng (Draft / Waiting / Ready / Done) -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='state']" position="attributes">
                <attribute name="column_invisible">False</attribute>
                <attribute name="widget">badge</attribute>
                <attribute name="decoration-success">state == 'done'</attribute>
                <attribute name="decoration-info">state == 'assigned'</attribute>
                <attribute name="decoration-warning">state in ('confirmed', 'waiting')</attribute>
                <attribute name="decoration-muted">state in ('draft', 'cancel')</attribute>
            </xpath>

            <!-- Các trường kiểm soát hiển thị giao diện theo loại hoạt động kho -->
            <xpath expr="//notebook" position="before">
                <field name="picking_category" invisible="1"/>
                <field name="show_scale_tab" invisible="1"/>
                <field name="show_spare_parts_tab" invisible="1"/>
                <field name="show_explosive_tab" invisible="1"/>
            </xpath>

            <!-- Thêm các Tab chuyên biệt theo từng loại hoạt động kho vào Notebook -->
            <xpath expr="//notebook" position="inside">
                <!-- 1. Tab Trạm Cân Mỏ Đá: Tự động hiển thị khi là Kho / Hoạt động Đá Thành Phẩm (hoặc bật cờ cân xe) -->
                <page string="Trạm Cân Mỏ Đá" name="scale_info" invisible="not show_scale_tab">
                    <group>
                        <group string="Thông Tin Phương Tiện &amp; Cân">
                            <field name="is_scale_picking" widget="boolean_toggle"/>
                            <field name="vehicle_plate" placeholder="VD: 36C-123.45"/>
                            <field name="driver_name" placeholder="Họ tên tài xế"/>
                            <field name="weigh_scale_number"/>
                            <field name="crushing_plant"/>
                        </group>
                        <group string="Khối Lượng &amp; Thể Tích Quy Đổi">
                            <field name="tare_weight"/>
                            <field name="gross_weight"/>
                            <div class="o_td_label">
                                <label for="net_weight" string="Khối Lượng Tịnh (Kg)" style="font-weight: bold; color: #007bff;"/>
                            </div>
                            <field name="net_weight" nolabel="1" style="font-weight: bold; font-size: 16px; color: #007bff;"/>
                            <field name="density"/>
                            <div class="o_td_label">
                                <label for="volume_m3" string="Thể Tích Quy Đổi (m³)" style="font-weight: bold; color: #28a745;"/>
                            </div>
                            <field name="volume_m3" nolabel="1" style="font-weight: bold; font-size: 16px; color: #28a745;"/>
                            <field name="weigh_time_first"/>
                            <field name="weigh_time_second"/>
                        </group>
                    </group>
                </page>

                <!-- 2. Tab Phụ Tùng Thiết Bị: Tự động hiển thị khi là Hoạt động Xuất / Điều chuyển Phụ Tùng (BR-10) -->
                <page string="Vật Tư - Phụ Tùng Thiết Bị" name="spare_parts_info" invisible="not show_spare_parts_tab">
                    <group>
                        <group string="Xuất Cấp / Điều Chuyển Phụ Tùng Cho Thiết Bị Mỏ (BR-10)">
                            <field name="equipment_id" placeholder="Chọn thiết bị / xe máy mỏ nhận phụ tùng"/>
                        </group>
                    </group>
                </page>

                <!-- 3. Tab Vật Liệu Nổ Công Nghiệp: Tự động hiển thị khi là Hoạt động Kho VLNCN -->
                <page string="Vật Liệu Nổ Công Nghiệp (VLNCN)" name="explosive_info" invisible="not show_explosive_tab">
                    <group>
                        <group string="Quản Lý Xuất Cấp Nổ Mìn Mỏ Đá">
                            <field name="blasting_passport_code" placeholder="Mã hộ chiếu / phương án nổ mìn"/>
                            <field name="blasting_commander" placeholder="Chỉ huy nổ mìn chịu trách nhiệm"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Form View của Stock Picking Type để cấu hình Phân Loại Nghiệp Vụ Kho -->
    <record id="view_picking_type_form_inherit_hoangphuc" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.hoangphuc</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="picking_category"/>
            </xpath>
        </field>
    </record>

    <!-- Kế thừa Tree/List View của Stock Picking để hiển thị nhanh BKS, Phân Loại và Khối Lượng Tịnh -->
    <record id="vpicktree_inherit_hoangphuc" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.hoangphuc</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <!-- <field name="picking_category" optional="show" widget="badge"
                       decoration-info="picking_category == 'stone'"
                       decoration-warning="picking_category == 'spare_parts'"
                       decoration-danger="picking_category == 'explosives'"/> -->
                <field name="vehicle_plate" optional="show"/>
                <field name="equipment_id" optional="show" string="Thiết Bị Nhận VT"/>
                <field name="blasting_passport_code" optional="show" string="Hộ Chiếu Nổ Mìn"/>
                <field name="net_weight" optional="show" sum="Tổng Kg"/>
                <field name="volume_m3" optional="show" sum="Tổng m³"/>
            </xpath>
        </field>
    </record>
</odoo>
